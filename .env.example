# ============================================================
# GAIA PRIME / PRIAM - Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# This system is designed for air-gapped / local-first operation.
# No cloud services are used.
# ============================================================

# -- Supabase Local --
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# -- Database (PostgreSQL via Supabase) --
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# -- MCP Configuration --
MCP_STATE_DB=./data/mcp-state.sqlite
MCP_LOG_LEVEL=info

# -- Rclone Data Bridge --
RCLONE_REMOTE_NAME=local-assets
RCLONE_MOUNT_PATH=/mnt/gaia-assets

# -- Application --
NODE_ENV=development
APP_PORT=3000
